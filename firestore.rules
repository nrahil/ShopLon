rules_version = '2';

// Firestore now holds only the wishlist. Catalogue, cart, orders and payments
// live in the ShopLon backend (Postgres + Redis), where the server enforces
// prices, stock and payment state. Clients can't write any of those directly.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Each user's wishlist: only that user can read or change it,
    // with a bounded document shape.
    match /users/{uid}/wishlist/{itemId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
             'id', 'image', 'brandName', 'title', 'price', 'priceAfetDiscount',
             'dicountpercent', 'description', 'category', 'rating', 'stock', 'images'])
        && request.resource.data.id == itemId
        && request.resource.data.title is string
        && request.resource.data.title.size() < 300;
    }

    // Everything else, including the legacy cart and orders, is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
