# Copy to .env (git-ignored). Docker Compose reads it automatically.
FIREBASE_PROJECT_ID=e-commerce-e3c9f
CORS_ORIGINS=http://localhost:5000

# mock (default, no account needed) or stripe (test mode)
PAYMENT_PROVIDER=mock
MOCK_PSP_SECRET_KEY=sk_mock_change_me
MOCK_PSP_WEBHOOK_SECRET=whsec_mock_change_me
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Load testing only: lets scripts/flash-sale.ts mint tokens for fake users.
# The API refuses to start with this enabled when NODE_ENV=production.
API_NODE_ENV=development
AUTH_ALLOW_DEV_TOKENS=true
AUTH_DEV_SECRET=replace-with-at-least-32-random-characters
