{
  "name": "shoplon-backend",
  "version": "1.0.0",
  "description": "ShopLon commerce API, worker and mock payment provider",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:psp": "tsx watch src/mock-psp/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration --no-file-parallelism",
    "load:flash-sale": "tsx scripts/flash-sale.ts"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.3.0",
    "bullmq": "^6.7.8",
    "fastify": "^5.12.8",
    "ioredis": "^6.1.0",
    "jose": "^6.2.18",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "stripe": "^23.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true
}
